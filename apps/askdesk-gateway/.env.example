NODE_ENV=development
HOST=127.0.0.1
PORT=4001
LOG_LEVEL=info

# Groq LLM API Key
GROQ_API_KEY=gsk_your_groq_api_key_here

# Core Database connection (for API key validation and usage records)
MONGODB_URI=mongodb://127.0.0.1:27017/askdesk_core

# Redis URL (leave empty or 'embedded' to use in-memory ioredis-mock)
REDIS_URL=embedded

# JWT secret from core (to protect analytics endpoint)
JWT_ACCESS_SECRET=askdesk-super-secret-jwt-access-token-key-2026-min-32-chars
