{
  "name": "askdesk-gateway",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "AskDesk AI Gateway: High-performance streaming LLM proxy, rate limiting, semantic caching, telemetry & failover",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.4",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "groq-sdk": "^0.15.0",
    "ioredis": "^5.6.0",
    "ioredis-mock": "^8.9.0",
    "mongoose": "^8.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "openai": "^4.86.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
