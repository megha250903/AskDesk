{
  "name": "askdesk-chat",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "AskDesk Chat & RAG Engine: Document ingestion, chunking, Qdrant vector retrieval, citations, and streaming RAG",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^9.0.3",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "ioredis-mock": "^8.9.0",
    "mongoose": "^8.12.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.13.9",
    "@types/pdf-parse": "^1.1.4",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
