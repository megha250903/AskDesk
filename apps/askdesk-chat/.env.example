NODE_ENV=development
HOST=127.0.0.1
PORT=4002
LOG_LEVEL=info

# Gateway URL for LLM Chat & Embeddings
GATEWAY_URL=http://127.0.0.1:4001

# Core Database connection
MONGODB_URI=mongodb://127.0.0.1:27017/askdesk_core

# Redis URL (Option A: embedded ioredis-mock, Option B: redis://127.0.0.1:6379)
REDIS_URL=embedded

# Qdrant URL (Option A: embedded in-memory mock, Option B: http://127.0.0.1:6333)
QDRANT_URL=embedded

# JWT secret from core for authenticated operator requests
JWT_ACCESS_SECRET=askdesk-super-secret-jwt-access-token-key-2026-min-32-chars
