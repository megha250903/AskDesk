# Application Environment
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/askdesk_core

# Auth Secrets (min 32 chars)
JWT_ACCESS_SECRET=askdesk-super-secret-jwt-access-token-key-2026-min-32-chars
JWT_REFRESH_SECRET=askdesk-super-secret-jwt-refresh-token-key-2026-min-32-chars
COOKIE_SECRET=askdesk-super-secret-cookie-signer-key-2026-min-32-chars

# Billing (Stripe test mode)
STRIPE_SECRET_KEY=sk_test_askdesk_mock_key
STRIPE_WEBHOOK_SECRET=whsec_askdesk_mock_key
