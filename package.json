{
  "name": "askdesk-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AskDesk: AI-powered technical support helpdesk with gateway, tenant isolation, and prompt evaluation",
  "scripts": {
    "dev:core": "pnpm --filter askdesk-core dev",
    "dev:gateway": "pnpm --filter askdesk-gateway dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.3"
  },
  "packageManager": "pnpm@10.32.1"
}
